# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environment
.venv/
venv/
ENV/
env/

# --- SECURITY: Never commit secrets ---
# NOTE: .env was committed in 3b5c6b3/441da0f and purged in Phase 0 (see FIXING_PLAN.md).
# Patterns below cover every variant, not just bare `.env`.
.env
.env.*
!.env.example
.secrets.toml
.secrets.baseline.local
*.key
*.pem
*.p12
*.pfx
credentials.json
service-account*.json

# Large data files
data/*.csv
data_new/*.csv
data_new/*.h5
data_new/liar/*.tsv
*.h5

# Keep directory structure
!data/.gitkeep
!data_new/.gitkeep

# Model files (large binary artifacts)
models/*.keras
models/pipeline*.joblib
models/v_*/

# Keep essential model files for deployment
!models/model.joblib
!models/tfidf.joblib
!models/scaler.joblib
!models/ood_centroid.npy

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/*.log
logs/*.png
logs/*.csv
training_log.txt

# Testing
.coverage
htmlcov/
.pytest_cache/

# Build
/dist/
build/
!landing-page/dist/
*.egg-info/

# Temporary files
*.tmp
*.bak

# Database (local dev only)
*.db

# Docker
.docker/

# Debug / scratch scripts — never commit these
test_gemini_key.py
scratch_*.py
test-site*.cjs

# Caches
.ruff_cache/

# Local planning doc — do not commit
ROADMAP.md
node_modules/
