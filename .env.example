# =============================================================================
# Fake News Detector - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# --- External API Keys ---
GNEWS_API_KEY=your_gnews_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- API Authentication ---
# Comma-separated list of valid API keys for the FastAPI REST API
# Format: key1:user1,key2:user2
API_KEYS=your_api_key_here:your_username

# --- Application Settings ---
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json              # json | text

# --- Model Settings ---
MODEL_DIR=models
MODEL_VERSION=latest         # or specific version like v1.0.0
PREDICTION_CONFIDENCE_THRESHOLD=0.5

# --- Database Settings ---
DATABASE_URL=sqlite:///analysis_history.db
DB_POOL_SIZE=5

# --- Rate Limiting ---
API_RATE_LIMIT=30/minute
BATCH_RATE_LIMIT=10/minute
MAX_BATCH_SIZE=50

# --- External API Settings ---
GNEWS_TIMEOUT_SECONDS=10
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MODEL_NAME=gemini-2.5-flash

# --- CORS Settings (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# --- Feature Flags ---
ENABLE_GEMINI_VERIFICATION=true
ENABLE_WEB_SEARCH=true
ENABLE_OOD_DETECTION=true
