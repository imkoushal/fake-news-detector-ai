# =============================================================================
# Fake News Detector — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# --- External API Keys ---
GNEWS_API_KEY=your_gnews_api_key_here # Get free key at gnews.io
GROQ_API_KEY=your_groq_api_key_here   # Get free key at console.groq.com

# --- Admin Dashboard ---
ADMIN_SECRET=your_strong_secret_here  # Required to access /api/v1/admin/stats

# --- Application Settings ---
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Database Settings (PostgreSQL in production, SQLite locally) ---
DATABASE_URL=postgresql://user:pass@host/dbname   # Leave unset for local SQLite

# --- Rate Limiting ---
API_RATE_LIMIT=30/minute
BATCH_RATE_LIMIT=10/minute
MAX_BATCH_SIZE=50

# --- CORS Settings (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501
