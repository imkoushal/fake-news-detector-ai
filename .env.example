# =============================================================================
# Fake News Detector — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# --- External API Keys ---
GNEWS_API_KEY=your_gnews_api_key_here # Get free key at gnews.io
GROQ_API_KEY=your_groq_api_key_here   # Get free key at console.groq.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id_here  # Get from console.cloud.google.com/apis/credentials
GOOGLE_FACTCHECK_API_KEY=your_api_key_here   # Enable Fact Check Tools API in Google Cloud Console
GOOGLE_SAFE_BROWSING_API_KEY=your_api_key_here # Enable Safe Browsing API in Google Cloud Console

# --- Admin Dashboard ---
ADMIN_SECRET=your_strong_secret_here  # Required to access /api/v1/admin/stats

# --- Telegram Bot (Phase 9.1) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here      # From @BotFather: /newbot
TELEGRAM_WEBHOOK_SECRET=random_secret_here  # Any random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`
# PUBLIC_BASE_URL=https://your-app.onrender.com  # Public https origin; on Render, RENDER_EXTERNAL_URL is auto-set
# TELEGRAM_DAILY_LIMIT=500                    # Max bot checks/day (cost guard)

# --- Application Settings ---
APP_ENV=development          # development | staging | production. In production
                             # (or when RENDER is set) Swagger /docs, /redoc,
                             # /openapi.json are disabled and /health is minimal.
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Health check ---
# Optional. If set, GET /health returns full diagnostics only when the caller
# sends this token via `X-Health-Token:` header or `?token=`. Otherwise /health
# returns just {"status": "ok"} in production. Leave unset to keep prod minimal.
HEALTH_DETAIL_TOKEN=         # e.g. python -c "import secrets;print(secrets.token_urlsafe(24))"

# --- Database Settings (PostgreSQL in production, SQLite locally) ---
DATABASE_URL=postgresql://user:pass@host/dbname   # Leave unset for local SQLite

# --- Rate Limiting ---
API_RATE_LIMIT=30/minute
BATCH_RATE_LIMIT=10/minute
MAX_BATCH_SIZE=50

# --- CORS Settings (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501
